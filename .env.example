# --- Database (required) ---------------------------------------------------
# Render: create a Postgres instance, then paste its Internal Database URL here.
DATABASE_URL=postgresql://user:password@localhost:5432/wealthops

# --- Session (required) -----------------------------------------------------
# Any long random string. `openssl rand -hex 32` works well.
SESSION_SECRET=change-me-to-a-random-string

# --- Document storage (optional) --------------------------------------------
# Leave unset to run in metadata-only mode — uploads are tracked but not
# stored. Set all three to enable real S3 storage.
S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
